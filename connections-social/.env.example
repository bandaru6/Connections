# =============================================================================
# Connections Social - Environment Variables
# =============================================================================
# Copy this file to .env: cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Docker Compose Settings
# -----------------------------------------------------------------------------

# PostgreSQL credentials
POSTGRES_USER=connections
POSTGRES_PASSWORD=connections
POSTGRES_DB=connections

# InsightFace model name (buffalo_l recommended for accuracy)
INSIGHTFACE_MODEL=buffalo_l

# -----------------------------------------------------------------------------
# Exposed Ports (change if conflicts with other services)
# -----------------------------------------------------------------------------

POSTGRES_PORT=5433
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000

# -----------------------------------------------------------------------------
# Frontend Settings
# -----------------------------------------------------------------------------

# Backend API URL (used by browser - must be localhost for external access)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Advanced: Override these only for custom setups
# -----------------------------------------------------------------------------

# Database URL (auto-configured by docker-compose, override for external DB)
# DATABASE_URL=postgresql://connections:connections@postgres:5432/connections

# Redis URL (auto-configured by docker-compose, override for external Redis)
# REDIS_URL=redis://redis:6379/0

# Profile matching threshold (0.0 - 1.0, higher = stricter matching)
# PROFILE_MATCH_THRESHOLD=0.50
