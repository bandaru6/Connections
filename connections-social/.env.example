# =============================================================================
# Connections Social - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values
# =============================================================================

# -----------------------------------------------------------------------------
# Backend (FastAPI)
# -----------------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL=postgresql://connections:connections@localhost:5433/connections

# Redis connection string
REDIS_URL=redis://localhost:6379/0

# Path to profile images directory
PROFILES_DIR=./data/profiles

# Path to uploads directory
UPLOADS_DIR=./uploads

# InsightFace model name (buffalo_l recommended)
INSIGHTFACE_MODEL=buffalo_l

# Profile matching threshold (0.0 - 1.0)
PROFILE_MATCH_THRESHOLD=0.50

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# -----------------------------------------------------------------------------

# Backend API URL (for server-side requests)
BACKEND_URL=http://localhost:8000

# Node environment
NODE_ENV=development

# -----------------------------------------------------------------------------
# Docker Compose
# -----------------------------------------------------------------------------

# PostgreSQL credentials
POSTGRES_USER=connections
POSTGRES_PASSWORD=connections
POSTGRES_DB=connections

# Exposed ports (change if conflicts)
POSTGRES_PORT=5433
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000
